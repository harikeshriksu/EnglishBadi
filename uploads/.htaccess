# Never execute PHP or any other script inside /uploads - defence in depth
# in case a disguised file ever ends up here. Images still serve normally.
<FilesMatch "\.(php|php[3-8]?|phtml|phar|pht|cgi|pl|py|sh|asp|aspx|jsp)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>

<IfModule mod_php.c>
    php_flag engine off
</IfModule>

RemoveHandler .php .php3 .php4 .php5 .php7 .phtml .pht
RemoveType .php .php3 .php4 .php5 .php7 .phtml .pht

Options -Indexes -ExecCGI
